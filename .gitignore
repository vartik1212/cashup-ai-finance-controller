# ==============================================================================
# CashUP — Root .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Allow example environment templates
!.env.example
!*.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
secrets/
credentials.json

# ------------------------------------------------------------------------------
# 2. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & linting caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
nosetests.xml
coverage.xml

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Build
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/

# Vite / Frontend build output
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/

# ------------------------------------------------------------------------------
# 4. Local Database & Runtime Files
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
reconai.db
data/*.db
data/reconai.db

# ------------------------------------------------------------------------------
# 5. Logs & Runtime Artifacts
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock

# ------------------------------------------------------------------------------
# 6. IDEs, Editors & Operating System Junk
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Linux
*~

# Editors
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# AI agent local runtime directories
.agents/
.gemini/
