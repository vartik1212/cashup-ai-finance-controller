# ==============================================================================
# CashUP — Environment Variables Configuration
# Copy this file to .env and configure your local settings:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Optional)
# If left blank or omitted, CashUP runs in deterministic "Data-Only" mode
# without requiring an external LLM connection.
# Obtain an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Primary and Fallback Gemini Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Backend Server Bind Settings
HOST=0.0.0.0
PORT=8000
